# Optional. Copy to ~/.config/systemd/user/ and run: systemctl --user enable --now osmia
# Start it from the compositor instead if you prefer (for labwc: add "osmia" to autostart).
[Unit]
Description=osmia shell (bar, launcher, notifications)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.cargo/bin/osmia
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
